# sc_admin is the Splunk Cloud admin role; including it alongside admin
# keeps these knowledge objects manageable on Cloud stacks.

[]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = system

[eventtypes]
export = system

[tags]
export = system

[props]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[transforms]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[lookups]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[macros]
export = system

[savedsearches]
export = system

[inputs]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = system
