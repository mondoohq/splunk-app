# Application-level permissions.
# sc_admin is the Splunk Cloud admin role — included alongside admin so the
# app's knowledge objects stay manageable when installed on a Cloud stack.

[]
access = read : [ * ], write : [ admin, sc_admin, power ]

### EVENT TYPES

[eventtypes]
export = system


### PROPS

[props]
export = system


### TRANSFORMS

[transforms]
export = system


### LOOKUPS

[lookups]
export = system


### VIEWSTATES: even normal users should be able to create shared viewstates

[viewstates]
access = read : [ * ], write : [ * ]
export = system
